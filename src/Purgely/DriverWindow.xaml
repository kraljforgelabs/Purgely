<Window x:Class="Purgely.DriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgely – Driver updates" Height="640" Width="1100" MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button x:Name="HomeButton" DockPanel.Dock="Left" Visibility="Collapsed" Padding="10,8" Margin="0,4,16,0"
                    VerticalAlignment="Top" ToolTip="Back to the home screen (Esc)" AutomationProperties.Name="Back to home">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;"/>
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Home"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Driver updates" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitle}" Text="Asking Windows Update…"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource InfoBarInfo}" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Style="{StaticResource InfoBarIconInfo}"/>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Drivers come only from Windows Update – signed and tested by Microsoft, the same ones Windows itself installs. Purgely never downloads drivers from other websites. If a new driver causes trouble, go to Device Manager → the device → Properties → Driver → Roll Back Driver. Graphics cards often get newer drivers through their own app (NVIDIA app, AMD Software, Intel Driver &amp; Support Assistant)."/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ListCard}">
            <Grid>
                <DataGrid x:Name="DriversGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0"
                          MinRowHeight="36" ColumnHeaderStyle="{StaticResource GridHeader}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" Click="Check_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Device type" Binding="{Binding ClassText}" Width="130" IsReadOnly="True" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="Driver" Binding="{Binding Title}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource GridWrapText}"/>
                        <DataGridTextColumn Header="Maker" Binding="{Binding Manufacturer}" Width="150" IsReadOnly="True" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="200" IsReadOnly="True" ElementStyle="{StaticResource GridWrapText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="BusyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <TextBlock x:Name="BusyText" Style="{StaticResource BodyStrongText}" HorizontalAlignment="Center"
                               Text="Asking Windows Update which drivers are newer…"/>
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4" Margin="0,12,0,4"/>
                    <TextBlock Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Text="This can take up to a minute."/>
                </StackPanel>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="480">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{StaticResource OkBrush}"/>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource BodyStrongText}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" Text="All drivers are up to date."/>
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Click="Check_Again_Click" Padding="12,6" x:Name="RecheckButton">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;"/>
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Check again"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="InstallButton" Style="{StaticResource AccentButton}" Click="Install_Click" Padding="16,6"
                        Content="Install selected" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
