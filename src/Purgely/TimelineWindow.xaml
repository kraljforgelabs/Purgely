<Window x:Class="Purgely.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgely – PC Timeline" Height="700" Width="1150" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button x:Name="HomeButton" DockPanel.Dock="Left" Visibility="Collapsed" Padding="10,8" Margin="0,4,16,0"
                    VerticalAlignment="Top" ToolTip="Back to the home screen (Esc)" AutomationProperties.Name="Back to home">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;"/>
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Home"/>
                </StackPanel>
            </Button>
            <StackPanel>
            <TextBlock Text="PC Timeline" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Everything installed, updated and removed on this PC – and everything Purgely did. ⚠ marks programs from different publishers that were installed together (possible bundleware)."/>
        </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Width="300">
                <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" AutomationProperties.Name="Search events"/>
                <TextBlock Text="Search events" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <CheckBox x:Name="WarningsOnly" Content="Only ⚠ installed together" Margin="20,0,0,0"
                      VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock/>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource ListCard}">
        <DataGrid x:Name="EventsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserSortColumns="False"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  Background="Transparent" BorderThickness="0" MinRowHeight="36"
                  ColumnHeaderStyle="{StaticResource GridHeader}">
            <DataGrid.Resources>
                <Style x:Key="EventText" TargetType="TextBlock" BasedOn="{StaticResource GridWrapText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeaderText}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="70" MinWidth="70" ElementStyle="{StaticResource EventText}"/>
                <DataGridTextColumn Header="Event" Binding="{Binding TypeText}" Width="190" MinWidth="190" ElementStyle="{StaticResource EventText}"/>
                <DataGridTextColumn Header="Program" Binding="{Binding Program}" Width="3*" MinWidth="200" ElementStyle="{StaticResource EventText}"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="3*" MinWidth="260" ElementStyle="{StaticResource EventText}"/>
            </DataGrid.Columns>
        </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Click="Clear_Click" Padding="12,6" Margin="0,0,16,0" AutomationProperties.Name="Clear history"
                    ToolTip="Empty this list. Purgely keeps what it needs to notice removed programs and their leftovers.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;"/>
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Clear history"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Padding="16,6" MinWidth="96"/>
            <TextBlock x:Name="CountText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
