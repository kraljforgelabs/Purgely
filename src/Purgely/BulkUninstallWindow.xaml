<Window x:Class="Purgely.BulkUninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgely – Uninstall several programs" Width="860" Height="620" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" FontSize="22" Text="Uninstall several programs"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,12" TextWrapping="Wrap"
                       Text="Programs are removed one at a time, never two at once. Those that support it are removed without questions; the others open their own window. Answer it, and Purgely carries on by itself. At the end, one leftover scan covers them all."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <CheckBox x:Name="QuietBox" IsChecked="True" VerticalAlignment="Center"
                      Content="Quiet mode – no questions where the program allows it (recommended)"
                      ToolTip="Windows Installer, Inno Setup and NSIS uninstallers – and any program that offers a quiet uninstall – run without questions. Others still show their window."/>
            <TextBlock x:Name="ElapsedText" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}"/>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource ListCard}">
            <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" Background="Transparent" BorderThickness="0" MinRowHeight="38"
                      SelectionMode="Single" CanUserSortColumns="False" ColumnHeaderStyle="{StaticResource GridHeader}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource IconText}" Text="{Binding Icon}" HorizontalAlignment="Center"
                                           Foreground="{Binding IconBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource GridWrapText}"/>
                    <DataGridTextColumn Header="How" Binding="{Binding Kind}" Width="*" ElementStyle="{StaticResource GridWrapText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" ElementStyle="{StaticResource GridWrapText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border x:Name="AttentionBar" Grid.Row="3" Style="{StaticResource InfoBarWarning}" Margin="0,12,0,0" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="AttentionIcon" Style="{StaticResource InfoBarIconWarning}"/>
                <TextBlock x:Name="AttentionText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- A Grid, not a DockPanel: a long status text must never push the buttons out of the window. -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <ProgressBar x:Name="Progress" Height="4" MinHeight="4" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SkipButton" Click="Skip_Click" Padding="14,6" Visibility="Collapsed"
                        ToolTip="Stop waiting for this program and move on to the next one. Its uninstaller keeps running on its own.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE893;"/>
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Skip this one"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StartButton" Click="Start_Click" Padding="14,6" Margin="8,0,0,0" Style="{StaticResource AccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;"/>
                        <TextBlock x:Name="StartText" Style="{StaticResource ButtonLabel}" Text="Start"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CloseButton" Click="Close_Click" Padding="14,6" Margin="8,0,0,0" Content="Cancel" MinWidth="96"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
