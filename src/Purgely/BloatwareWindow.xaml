<Window x:Class="Purgely.BloatwareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgely – Bloatware" Height="760" Width="1300" MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button x:Name="HomeButton" DockPanel.Dock="Left" Visibility="Collapsed" Padding="10,8" Margin="0,4,16,0"
                    VerticalAlignment="Top" ToolTip="Back to the home screen (Esc)" AutomationProperties.Name="Back to home">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;"/>
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Home"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Bloatware &amp; Windows clutter" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Apps that came with Windows or your PC, the ads and suggestions Windows shows, AI features and privacy settings. Everything you change is saved to the Undo center, and Purgely tells you if Windows brings something back."/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" BorderThickness="0" Background="Transparent" Padding="0">
            <TabItem Header="Preinstalled apps" Style="{StaticResource PillTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <CheckBox x:Name="ShowKeep" Content="Also show apps to keep" VerticalAlignment="Center"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <TextBlock x:Name="AppsHint" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"
                                   Text="Ticked: ads, trials and promotions. 'Check' items are yours to decide."/>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource ListCard}">
                        <DataGrid x:Name="AppsGrid" AutoGenerateColumns="False" SelectionMode="Extended" HeadersVisibility="Column"
                                  GridLinesVisibility="None" CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                                  MinRowHeight="36" ColumnHeaderStyle="{StaticResource GridHeader}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" Click="Check_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Verdict" Binding="{Binding RatingText}" Width="170" IsReadOnly="True" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource GridWrapText}"/>
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTextColumn Header="Why" Binding="{Binding Why}" Width="3*" IsReadOnly="True" ElementStyle="{StaticResource GridWrapText}"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="160" IsReadOnly="True" ElementStyle="{StaticResource GridWrapText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Click="RemoveApps_Click" Padding="14,6" AutomationProperties.Name="Remove ticked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;"/>
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Remove ticked"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="AppsCount" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Ads, AI &amp; privacy" Style="{StaticResource PillTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ListCard}">
                        <DataGrid x:Name="TweaksGrid" AutoGenerateColumns="False" SelectionMode="Extended" HeadersVisibility="Column"
                                  GridLinesVisibility="None" CanUserAddRows="False" Background="Transparent" BorderThickness="0"
                                  MinRowHeight="40" ColumnHeaderStyle="{StaticResource GridHeader}">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource GroupHeaderText}" Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox x:Name="Box" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" Click="Check_Click"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOn}" Value="False">
                                                    <Setter TargetName="Box" Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Now" Binding="{Binding StateText}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTextColumn Header="What" Binding="{Binding Name}" Width="2*" IsReadOnly="True" ElementStyle="{StaticResource GridWrapText}"/>
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*" IsReadOnly="True" ElementStyle="{StaticResource GridWrapText}"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="200" IsReadOnly="True" ElementStyle="{StaticResource GridWrapText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Click="TurnOff_Click" Padding="14,6" AutomationProperties.Name="Turn off ticked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7E8;"/>
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Turn off ticked"/>
                                </StackPanel>
                            </Button>
                            <Button Click="OpenUndo_Click" Padding="12,6" Margin="8,0,0,0" AutomationProperties.Name="Undo center"
                                    ToolTip="Turn things back on from the Undo center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;"/>
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Undo center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="TweaksCount" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="ExtensionsTab" Header="Browser extensions" Style="{StaticResource PillTab}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Extensions can see what you do in the browser. Purgely shows what each one may do and where it came from. Remove them in the browser itself (so sync doesn't bring them back) – the button opens the right page."/>
                    <Border Grid.Row="1" Style="{StaticResource ListCard}">
                        <DataGrid x:Name="ExtensionsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0"
                                  MinRowHeight="38" ColumnHeaderStyle="{StaticResource GridHeader}">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource GroupHeaderText}" Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Extension" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource GridWrapText}"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTextColumn Header="From" Binding="{Binding SourceText}" Width="130" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridWrapText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FromStore}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource AccentButton}" Click="ManageExtension_Click" Padding="14,6"
                                    AutomationProperties.Name="Manage in browser">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;"/>
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Manage in browser"/>
                                </StackPanel>
                            </Button>
                            <Button Click="ExtensionStore_Click" Padding="12,6" Margin="8,0,0,0" AutomationProperties.Name="Store page">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE774;"/>
                                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Store page"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="ExtensionsCount" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border x:Name="BusyOverlay" Grid.RowSpan="2" Margin="-20" Style="{StaticResource BusyScrim}" Visibility="Collapsed">
            <Border Style="{StaticResource BusyCard}" Width="440">
                <StackPanel>
                    <TextBlock x:Name="BusyTitle" Text="Looking for bloatware…" Style="{StaticResource BusyTitleText}" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
