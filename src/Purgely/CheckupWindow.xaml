<Window x:Class="Purgely.CheckupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgely – Checkup" Height="760" Width="1100" MinHeight="520" MinWidth="760">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button x:Name="HomeButton" DockPanel.Dock="Left" Visibility="Collapsed" Padding="10,8" Margin="0,4,16,0"
                    VerticalAlignment="Top" ToolTip="Back to the home screen (Esc)" AutomationProperties.Name="Back to home">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;"/>
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Home"/>
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Checkup" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                           Text="Your whole PC at a glance. Only things Purgely is sure about are ticked, everything goes to the Undo center, and nothing happens until you click &quot;Fix ticked&quot;."/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                            <DockPanel>
                                <CheckBox x:Name="Box" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0"
                                          IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button x:Name="OpenButton" DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,6" Margin="12,0,0,0"
                                        Content="{Binding OpenText}" Click="OpenSection_Click" Tag="{Binding}"/>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="{Binding Icon}" Margin="0,0,8,0"/>
                                        <TextBlock Style="{StaticResource BodyStrongText}" Text="{Binding Title}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Expander x:Name="DetailsExpander" Header="Details" Margin="0,6,0,0" Padding="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding Details}" Margin="4,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="12.5"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Failed}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding CanFix}" Value="False">
                                <Setter TargetName="Box" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                <Setter TargetName="DetailsExpander" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OpenText}" Value="">
                                <Setter TargetName="OpenButton" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="FixButton" DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Click="Fix_Click" Padding="14,6" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE90F;"/>
                    <TextBlock Style="{StaticResource ButtonLabel}" Text="Fix ticked"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="SummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"/>
        </DockPanel>

        <Border x:Name="BusyOverlay" Grid.RowSpan="3" Margin="-20" Style="{StaticResource BusyScrim}" Visibility="Collapsed">
            <Border Style="{StaticResource BusyCard}" Width="460">
                <StackPanel>
                    <TextBlock x:Name="BusyTitle" Text="Checking your PC…" Style="{StaticResource BusyTitleText}" Margin="0,0,0,16"/>
                    <ProgressBar IsIndeterminate="True" Height="4" MinHeight="4"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
