<Window x:Class="Purgely.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgely" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        MinWidth="380" MaxWidth="640" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="24,22,24,18">
            <TextBlock x:Name="IconGlyph" DockPanel.Dock="Left" Style="{StaticResource IconText}" FontSize="26"
                       VerticalAlignment="Top" Margin="0,2,16,0"/>
            <StackPanel>
                <TextBlock x:Name="HeadingText" Style="{StaticResource BodyStrongText}" FontSize="16" TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20"/>
                </ScrollViewer>
            </StackPanel>
        </DockPanel>
        <!-- Command area, like Fluent ContentDialog -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
