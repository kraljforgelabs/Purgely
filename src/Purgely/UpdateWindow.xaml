<Window x:Class="Purgely.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgely – Update" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" FontSize="22" TextWrapping="Wrap"/>
        <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16"/>

        <Border Style="{StaticResource Card}" Padding="16,12">
            <StackPanel>
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="Step1Icon" Style="{StaticResource IconText}" Width="24" Text="&#xE9F5;"/>
                    <TextBlock x:Name="Step1Text" Style="{StaticResource BodyStrongText}" Text="Download the update"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="Step2Icon" Style="{StaticResource IconText}" Width="24" Text="&#xEA3A;" Opacity="0.5"/>
                    <TextBlock x:Name="Step2Text" Style="{StaticResource SecondaryText}" Text="Check that the download is genuine"/>
                </DockPanel>
                <DockPanel Margin="0,4">
                    <TextBlock x:Name="Step3Icon" Style="{StaticResource IconText}" Width="24" Text="&#xEA3A;" Opacity="0.5"/>
                    <TextBlock x:Name="Step3Text" Style="{StaticResource SecondaryText}" Text="Install it"/>
                </DockPanel>
                <ProgressBar x:Name="ProgressLine" IsIndeterminate="True" Height="4" MinHeight="4" Margin="0,12,0,4" Maximum="100"/>
                <DockPanel>
                    <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Style="{StaticResource CaptionText}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ResultBar" Style="{StaticResource InfoBarWarning}" Margin="0,12,0,0" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="ResultIcon" Style="{StaticResource InfoBarIconWarning}"/>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Expander x:Name="DetailsExpander" Header="Details from Windows Package Manager" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="VisibleButton" Click="Visible_Click" Padding="14,6" Visibility="Collapsed"
                    ToolTip="Some installers need to ask you questions. Run the update again in a visible window.">
                <TextBlock Style="{StaticResource ButtonLabel}" Text="Try again with the installer visible"/>
            </Button>
            <Button x:Name="CloseButton" Click="Close_Click" Padding="14,6" Margin="8,0,0,0" Content="Run in background" MinWidth="96"/>
        </StackPanel>
    </StackPanel>
</Window>
