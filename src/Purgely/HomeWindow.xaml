<Window x:Class="Purgely.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purgely" Height="740" Width="1340" MinHeight="660" MinWidth="1220"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">

    <Window.Resources>
        <!-- Palette: translucent neutrals work on both the light and the dark Fluent theme -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2F7DE1"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F2F7DE1"/>
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#662F7DE1"/>
        <SolidColorBrush x:Key="AttentionBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="AttentionBorderBrush" Color="#80D97706"/>
        <SolidColorBrush x:Key="OkBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#0F808080"/>
        <SolidColorBrush x:Key="CardHoverBrush" Color="#1F808080"/>
        <SolidColorBrush x:Key="CardPressedBrush" Color="#2E808080"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2E808080"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Keyboard focus ring (only shown when navigating with the keyboard) -->
        <Style x:Key="TileFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="11" BorderThickness="2"
                                BorderBrush="{StaticResource AccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Feature tile. Tag drives the state: "Loading" | "Ready" | "Attention" -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,14,14,12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="MinHeight" Value="196"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource TileFocusVisual}"/>
            <Setter Property="Tag" Value="Loading"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <!-- Attention dot, top-right -->
                                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,2,0,0"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Fill="{StaticResource AttentionBrush}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource CardPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Attention">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AttentionBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The main job of the app gets a light accent tint -->
        <Style x:Key="PrimaryTileButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
        </Style>

        <!-- Tile parts -->
        <Style x:Key="TileIconBox" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="TileIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileTitle" TargetType="AccessText">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TileSummary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Text" Value="Counting…"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Loading">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Attention">
                    <Setter Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Thin progress line under the summary, visible only while the tile is loading -->
        <Style x:Key="TileBusy" TargetType="ProgressBar">
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="Height" Value="3"/>
            <Setter Property="MinHeight" Value="3"/>
            <Setter Property="Width" Value="72"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Loading">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TileDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="6,0,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="*"/>     <!-- tiles + notices -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="AdminBadge" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12.5" Opacity="0.8"
                           Text="Checking permissions…"/>
                <Button Click="Checkup_Click" Padding="14,6" Margin="0,0,8,0" Style="{StaticResource AccentButton}"
                        ToolTip="Check the whole PC at once and fix what Purgely is sure about – with undo"
                        AutomationProperties.Name="Run checkup">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D9;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Checkup" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Move_Click" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Save your program list and install everything again on a new PC"
                        AutomationProperties.Name="Move to a new PC">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AB;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Move to new PC" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="Repair_Click" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Fix problems with devices, sound, internet and missing DLLs"
                        AutomationProperties.Name="Repair">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE90F;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Repair" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Click="Refresh_Click" Padding="12,6"
                        ToolTip="Recount everything (F5)" AutomationProperties.Name="Refresh all summaries">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsButton" Click="Settings_Click" Padding="10,6" Margin="8,0,0,0"
                        ToolTip="Settings, help and about Purgely" AutomationProperties.Name="Settings">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Purgely.ico" Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Purgely" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="ultimate PC tool" FontSize="15" Opacity="0.65"
                               VerticalAlignment="Bottom" Margin="12,0,0,6"/>
                </StackPanel>
                <TextBlock Opacity="0.75" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Pick a task to start. Nothing on your PC changes until you confirm – and almost everything can be undone."/>
            </StackPanel>
        </DockPanel>

        <!-- ============ Body: tiles (left) + notices (right) ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- The tiles grow with the window (up to a comfortable size), so a maximized window has no empty half. -->
            <Grid Grid.Column="0" Margin="-6,0,0,0" VerticalAlignment="Stretch"
                  KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MaxHeight="300"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MaxHeight="300"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                    <!-- Section 1: programs & cleanup -->
                    <TextBlock Grid.Row="0" Text="Programs and cleanup" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid Grid.Row="1" Columns="5" Rows="1" Margin="0,0,0,10">

                        <Button x:Name="TileUninstall" Style="{StaticResource PrimaryTileButton}" Click="Uninstall_Click" TabIndex="0"
                                AutomationProperties.Name="Uninstall programs"
                                AutomationProperties.HelpText="Open the list of installed programs">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE74D;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="_Uninstall programs"/>
                                <TextBlock x:Name="TileUninstallSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="See everything installed and remove it cleanly, traces included."/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TileLeftovers" Style="{StaticResource TileButton}" Click="Leftovers_Click" TabIndex="1"
                                AutomationProperties.Name="Clean leftovers"
                                AutomationProperties.HelpText="Programs that were removed but left files or registry entries behind">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE721;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="Clean _leftovers"/>
                                <TextBlock x:Name="TileLeftoversSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="Files left behind by programs you've removed. Or search by name."/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TileJunk" Style="{StaticResource TileButton}" Click="Junk_Click" TabIndex="2"
                                AutomationProperties.Name="Installer junk"
                                AutomationProperties.HelpText="Cached installers that no program uses any more">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE7B8;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="Installer _junk"/>
                                <TextBlock x:Name="TileJunkSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="Old setup files no program needs any more. Removal can be undone."/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TileUpdates" Style="{StaticResource TileButton}" Click="Updates_Click" TabIndex="3"
                                AutomationProperties.Name="Updates"
                                AutomationProperties.HelpText="Programs with a newer version available through winget">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE895;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="Program u_pdates"/>
                                <TextBlock x:Name="TileUpdatesSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="Newer versions of your programs – downloaded from the publishers and verified."/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TileBloatware" Style="{StaticResource TileButton}" Click="Bloatware_Click" TabIndex="4"
                                AutomationProperties.Name="Bloatware"
                                AutomationProperties.HelpText="Preinstalled apps, ads and suggestions">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE71D;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="_Bloatware"/>
                                <TextBlock x:Name="TileBloatwareSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="Preinstalled apps, ads in Start and tips. Settings can be undone; apps can be reinstalled."/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Section 2: speed & safety -->
                    <TextBlock Grid.Row="2" Text="Speed and safety" Style="{StaticResource SectionLabel}"/>
                    <UniformGrid Grid.Row="3" Columns="5" Rows="1">

                        <Button x:Name="TileStartup" Style="{StaticResource TileButton}" Click="Startup_Click" TabIndex="5"
                                AutomationProperties.Name="Startup"
                                AutomationProperties.HelpText="Programs that start together with Windows">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE945;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="_Startup"/>
                                <TextBlock x:Name="TileStartupSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="What starts with Windows. Turn things off to boot faster."/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TileDrivers" Style="{StaticResource TileButton}" Click="Drivers_Click" TabIndex="6"
                                AutomationProperties.Name="Drivers"
                                AutomationProperties.HelpText="Your hardware and newer, signed drivers for it">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE950;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="Dri_ver updates"/>
                                <TextBlock x:Name="TileDriversSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="Your PC's parts and newer drivers – only from Microsoft or the maker."/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TileTrial" Style="{StaticResource TileButton}" Click="Trial_Click" TabIndex="7"
                                AutomationProperties.Name="Install and Track"
                                AutomationProperties.HelpText="Install a program while Purgely watches, and undo it completely later">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xEA18;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="Install &amp; _Track"/>
                                <TextBlock x:Name="TileTrialSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="Check an installer, install it while Purgely watches, and undo it completely later."/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TileTimeline" Style="{StaticResource TileButton}" Click="Timeline_Click" TabIndex="8"
                                AutomationProperties.Name="Timeline"
                                AutomationProperties.HelpText="History of installs, updates and removals">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE81C;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="Ti_meline"/>
                                <TextBlock x:Name="TileTimelineSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="When programs arrived, changed or left – and what came bundled."/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TileUndo" Style="{StaticResource TileButton}" Click="Undo_Click" TabIndex="9"
                                AutomationProperties.Name="Undo center"
                                AutomationProperties.HelpText="Restore anything Purgely removed">
                            <StackPanel>
                                <Border Style="{StaticResource TileIconBox}">
                                    <TextBlock Style="{StaticResource TileIcon}" Text="&#xE7A7;"/>
                                </Border>
                                <AccessText Style="{StaticResource TileTitle}" Text="Un_do center"/>
                                <TextBlock x:Name="TileUndoSummary" Style="{StaticResource TileSummary}"/>
                                <ProgressBar Style="{StaticResource TileBusy}"/>
                                <TextBlock Style="{StaticResource TileDescription}"
                                           Text="Everything Purgely removed is backed up. Bring it back in one click."/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
            </Grid>

            <!-- ============ Notices ============ -->
            <Border Grid.Column="2" CornerRadius="8" BorderThickness="1" Padding="16,14"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="NoticesCount" DockPanel.Dock="Right" Opacity="0.6" VerticalAlignment="Center" FontSize="12.5"/>
                            <TextBlock Text="Notices" FontSize="15" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Things Purgely noticed in the background. Nothing here changes your PC by itself."/>
                    </StackPanel>

                    <!-- Checking state -->
                    <StackPanel x:Name="NoticesBusy" DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Checking startup items and recent installs…" FontSize="12.5" Opacity="0.7" TextWrapping="Wrap"/>
                        <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" Margin="0,6,0,0" IsTabStop="False"/>
                    </StackPanel>

                    <Grid>
                        <!-- Empty state -->
                        <StackPanel x:Name="NoticesEmpty" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="22"
                                       Foreground="{StaticResource OkBrush}"/>
                            <TextBlock Text="All quiet. Nothing needs your attention." Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="NoticesList" Focusable="False"
                                          AutomationProperties.Name="Notices">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                                Background="{StaticResource CardBrush}" BorderThickness="1"
                                                BorderBrush="{StaticResource CardBorderBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="NoticeIcon" Grid.RowSpan="2" Text="{Binding Icon}"
                                                           FontFamily="{StaticResource IconFont}" FontSize="16"
                                                           Margin="0,1,10,0" VerticalAlignment="Top"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" LineHeight="18"/>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Padding="10,3" FontSize="12" MinHeight="0" Content="{Binding ActionText}"
                                                            Tag="{Binding}" Click="NoticeAction_Click"
                                                            AutomationProperties.Name="{Binding ActionText}"/>
                                                    <Button Padding="10,3" FontSize="12" MinHeight="0" Content="Dismiss" Margin="6,0,0,0"
                                                            Tag="{Binding}" Click="NoticeDismiss_Click"
                                                            AutomationProperties.Name="Dismiss notice"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter TargetName="NoticeIcon" Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ Footer status line ============ -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Opacity="0.5" FontSize="12" VerticalAlignment="Center"
                       Text="KraljForge Labs · free · no ads"/>
            <TextBlock DockPanel.Dock="Right" Opacity="0.5" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"
                       Text="Tip: start typing a program's name to find it, or drop its icon here to uninstall it"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="FooterStatus" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" Opacity="0.8"
                           Text="Getting a quick overview…"/>
                <ProgressBar x:Name="FooterProgress" Width="120" Height="3" MinHeight="3" Margin="12,0,0,0"
                             Minimum="0" Maximum="8" Value="0" VerticalAlignment="Center" IsTabStop="False"/>
            </StackPanel>
        </DockPanel>

        <!-- ============ Welcome tour (first start only; part of this window, not a pop-up) ============ -->
        <Border x:Name="WelcomeOverlay" Grid.RowSpan="3" Margin="-20,-16,-20,-12" Background="{StaticResource ScrimBrush}"
                Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
            <!-- Two layers: the window's own background, then the Fluent solid surface on top (if the theme has it). -->
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
            <Border CornerRadius="10" Padding="28,24"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="WelcomeStep" DockPanel.Dock="Right" Opacity="0.6" FontSize="12.5" VerticalAlignment="Top"/>
                        <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock x:Name="WelcomeIcon" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </DockPanel>
                    <TextBlock x:Name="WelcomeTitle" Margin="0,16,0,0" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                               FontFamily="{StaticResource DisplayFont}"/>
                    <TextBlock x:Name="WelcomeText" Margin="0,10,0,0" FontSize="14" LineHeight="21" TextWrapping="Wrap" Opacity="0.85"
                               MinHeight="126"/>
                    <StackPanel x:Name="WelcomeDots" Orientation="Horizontal" Margin="0,20,0,0"/>
                    <DockPanel Margin="0,20,0,0">
                        <Button x:Name="WelcomeSkip" DockPanel.Dock="Left" Click="WelcomeSkip_Click" Padding="12,6" Content="Skip tour"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="WelcomeBack" Click="WelcomeBack_Click" Padding="14,6" MinWidth="90" Content="Back"/>
                            <Button x:Name="WelcomeNext" Click="WelcomeNext_Click" Padding="14,6" MinWidth="110" Margin="8,0,0,0"
                                    Style="{StaticResource AccentButton}" Content="Next"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            </Border>
        </Border>
    </Grid>
</Window>
